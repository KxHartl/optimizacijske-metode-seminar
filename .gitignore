# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*.log

# Python
__pycache__/
*.pyc
.venv/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
*.nav
*.snm
*.vrb

# RAG vector store (auto-generated, large)
.ai/rag/db/
.ai/rag/parsed/

# Environment / secrets
.env
.env.*
!.env.example

# LaTeX build directories (build-docs scripts + LaTeX Workshop)
docs/**/build/

# Generated PDFs in docs build (Tectonic outputs next to source)
docs/**/*.pdf
# ...ali slike koje main.tex ukljucuje su izvorni artefakti i moraju biti u repou
!docs/figures/*.pdf
!docs/zadatak/*.pdf

# Generated PDFs in dist (built by CI or scripts)
dist/**/*.pdf

# Bootstrap marker
.ai/.bootstrapped

# Personal notes
IDEAS.md
.obsidian/

# Lokalna kopija skeniranih predavanja (izvornik je u data/sources/lectures/)
predavanja_vjezbe.pdf

# Test / sandbox directories
TestRealm/

# Claude Code git worktrees — runtime, never tracked
.claude/worktrees/

# Udzbenik: slide/scan images are DERIVED from data/sources + docs/zadatak.
# The manifests are tracked; run `python src/extract_slides.py` to regenerate.
docs/udzbenik/slides/*.png
docs/udzbenik/zadatak/*.png

# Third-party material: kept locally, not published
data/sources/ivan/*
data/sources/matija/*
data/sources/lectures/*
data/processed/lectures_text_*/*.txt
